programa
{
	
	funcao inicio()
	{
		inteiro idade 
		

		escreva("----- Calculadora dias  -----\n")
		escreva("Informe sua idade: ")
		leia(idade)

		inteiro dias = idade * 365

		escreva("Você viveu " + dias + " dias\n")
	}
}
