programa
{
	
	funcao inicio()
	{
		real metros
		real centimetros
		escreva("Informe um valor em metros: ")
		leia(metros)

		centimetros = metros * 100.0

		escreva(metros + "m em centimetros é " + centimetros)

		
	}
}
