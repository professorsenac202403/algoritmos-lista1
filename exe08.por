programa
{
	
	funcao inicio()
	{
		real nota1, nota2, nota3

		escreva("---- Calculadora de Médias ----\n")
		escreva("Nota 1: ")
		leia(nota1)

		escreva("Nota 2: ")
		leia(nota2)

		escreva("Nota 3: ")
		leia(nota3)

		real media = (nota1 + nota2 + nota3) / 3

		escreva("A média é: " + media)
	}
}
