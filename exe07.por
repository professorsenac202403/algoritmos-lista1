programa
{
	
	funcao inicio()
	{
		real cm, polegadas 

		escreva("---- Programa de Conversão cm/in ----\n")
		escreva("Informe centimetros a serem convertidos: ")
		leia(cm)

		polegadas = cm * 0.39

		escreva("----- Resultado -----\n")
		escreva("Polegadas: " + polegadas)
		
	}
}
