programa
{
	inclua biblioteca Matematica
	funcao inicio()
	{
		real raio 
		escreva("--- Calculadora de Área Círculo ---\n")
		escreva("Informe o raio: ")
		leia(raio)

		
		real area = 3.14 * Matematica.potencia(raio, 2)

		escreva("A área é:" + area)
		
	}
}
