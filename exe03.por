programa
{
	
	funcao inicio()
	{
		real valorHora
		real numeroHoraTrabalhada
		real salario

		escreva("Informe o valor de hora trabalhada: ")
		leia(valorHora)

		escreva("Informe número de horas trabalhadas no mês: ")
		leia(numeroHoraTrabalhada)

		salario = valorHora * numeroHoraTrabalhada

		escreva("O salário é R$ " + salario)
		
	}
}
