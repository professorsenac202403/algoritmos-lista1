    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="metros" type="Real" array="False" size=""/>
            <declare name="centimetros" type="Real" array="False" size=""/>
            <output expression="&quot;Informe um valor em metros: &quot;" newline="True"/>
            <input variable="metros"/>
            <assign variable="centimetros" expression="metros * 100"/>
            <output expression="metros &amp; &quot;m em centimetros &#233;&quot; &amp; centimetros" newline="True"/>
        </body>
    </function>
