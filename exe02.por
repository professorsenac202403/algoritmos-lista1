programa
{
	
	funcao inicio()
	{
		real vCompra
		real pago 
		real  troco

		escreva("Informe o valor total da compra: ")
		leia( vCompra )

		escreva("Quanto o cliente pagou: ")
		leia(pago)

		troco = pago - vCompra

		escreva("O troco foi: " + troco)
		
		
	}
}
